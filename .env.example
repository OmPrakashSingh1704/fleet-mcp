# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored -- never commit real secrets.
#
# BEFORE pointing a live agent at a repo: enable branch protection on main
# (required `test` check, required review, code-owner review,
# enforce_admins) AND give self-dev its own bot identity (a machine user or
# a GitHub App), separate from the owner's account. See
# SECURITY.md#preconditions-before-pointing-a-live-agent-at-a-repo.
#
# Two separate tokens, one per service. Never reuse one for the other, and
# never embed a token in a remote URL: git authenticates through a
# credential helper that reads the token from the environment at call time.

# --- deploy-watcher -----------------------------------------------------
# Git remote for the fleet repo the watcher polls, checks out, and deploys
# from. Plain https URL -- no credentials in it.
REPO_REMOTE=https://github.com/OmPrakashSingh1704/flotilla-mcp.git

# Watcher token: polls for newly merged commits and fetches the checkout.
# Minimal fine-grained PAT scope, on THIS repository only:
#   Contents: Read-only   (Metadata: Read-only is implied)
WATCHER_GITHUB_TOKEN=github_pat_replace_me_watcher

# --- self-dev-mcp ---------------------------------------------------------
# Git remote for the same repo, used for the self-dev agent's own
# clone/branch/commit/push workflow. Usually the same URL as REPO_REMOTE,
# kept as a separate variable because self-dev-mcp and deploy-watcher must
# never share config that would let one stand in for the other.
SELF_DEV_REPO_REMOTE=https://github.com/OmPrakashSingh1704/flotilla-mcp.git

# Self-dev token: clone/push selfdev/* branches, open PRs, comment on
# issues, read PR check status. Should belong to a separate bot identity.
# Minimal fine-grained PAT scope, on THIS repository only:
#   Contents: Read and write
#   Pull requests: Read and write
#   Issues: Read and write
#   (Metadata: Read-only is implied)
SELF_DEV_GITHUB_TOKEN=github_pat_replace_me_self_dev

# owner/repo, e.g. OmPrakashSingh1704/flotilla-mcp
GITHUB_REPO_FULL_NAME=OmPrakashSingh1704/flotilla-mcp

# Optional: path to the fleet manifest (default fleet_manifest.yaml, relative
# to the process's working directory).
# FLEET_MANIFEST_PATH=fleet_manifest.yaml

# Optional: per-issue write attempt cap (default 5).
# SELF_DEV_MAX_ATTEMPTS=5

# Optional: per-run pytest timeout for the run_tests tool (default 600).
# SELF_DEV_TEST_TIMEOUT_SECONDS=600
