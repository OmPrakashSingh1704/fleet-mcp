# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored -- never commit real secrets.

# --- deploy-watcher -----------------------------------------------------
# Git remote for the fleet repo the watcher polls, checks out, and deploys
# from (e.g. https://github.com/OWNER/fleet-mcp.git). If it embeds a
# credential, use a token scoped to read-only checkout access.
REPO_REMOTE=https://github.com/OWNER/fleet-mcp.git

# --- self-dev-mcp ---------------------------------------------------------
# Git remote for the same repo, used for the self-dev agent's own
# clone/branch/commit/push workflow. Usually the same URL as REPO_REMOTE,
# kept as a separate variable because self-dev-mcp and deploy-watcher must
# never share config that would let one stand in for the other.
SELF_DEV_REPO_REMOTE=https://github.com/OWNER/fleet-mcp.git

# --- shared: GitHub API access --------------------------------------------
# Personal access token (or GitHub App installation token) with repo scope:
# self-dev-mcp uses it to open PRs, comment on issues, and check PR/CI
# status; deploy-watcher uses it to poll for newly merged commits.
GITHUB_TOKEN=ghp_replace_me

# owner/repo, e.g. OWNER/fleet-mcp
GITHUB_REPO_FULL_NAME=OWNER/fleet-mcp
